<Window
    x:Class="AnyDeskRehber.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="AnyDesk Rehber">

    <Grid x:Name="RootGrid" Background="{ThemeResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{ThemeResource SidebarBrush}">
            <Grid Padding="16,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="8,0,0,30">
                    <Border Width="48" Height="48" CornerRadius="14" Background="{ThemeResource AccentBrush}">
                        <TextBlock Text="➤" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AnyDesk" Foreground="{ThemeResource SidebarTextBrush}" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Rehber" Foreground="{ThemeResource SidebarMutedBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="KÜTÜPHANE" Foreground="{ThemeResource SidebarSectionBrush}" FontSize="11" FontWeight="Bold" Margin="8,0,0,10" />

                <StackPanel Grid.Row="2" Spacing="4">
                    <Button x:Name="AllButton" Click="AllButton_Click" Style="{StaticResource SidebarButtonStyle}">
                        <Grid Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AllActiveIndicator" Grid.Column="0" Width="3" Height="24" HorizontalAlignment="Left" Background="{ThemeResource AccentBrush}" CornerRadius="2" Visibility="Collapsed" />
                            <TextBlock Grid.Column="0" Text="▣" Foreground="White" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Tüm Bilgisayarlar" Foreground="{ThemeResource SidebarTextBrush}" FontSize="13" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Width="28" Height="24" Background="{ThemeResource AccentBrush}" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="AllCountText" Text="0" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="FavoritesButton" Click="FavoritesButton_Click" Style="{StaticResource SidebarButtonStyle}">
                        <Grid Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="FavoritesActiveIndicator" Grid.Column="0" Width="3" Height="24" HorizontalAlignment="Left" Background="{ThemeResource AccentBrush}" CornerRadius="2" Visibility="Collapsed" />
                            <TextBlock Grid.Column="0" Text="★" Foreground="{ThemeResource SidebarMutedBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Favoriler" Foreground="{ThemeResource SidebarTextBrush}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="FavoriteCountText" Text="0" Foreground="{ThemeResource SidebarMutedBrush}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <TextBlock Text="GRUPLAR" Foreground="{ThemeResource SidebarSectionBrush}" FontSize="11" FontWeight="Bold" Margin="8,24,0,6" />
                    <StackPanel x:Name="GroupPanel" Spacing="4" />
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="8" Margin="8,20,8,0">
                    <Border Height="1" Background="{ThemeResource SidebarDividerBrush}" />
                    <TextBlock Text="AnyDesk Rehber" Foreground="#8EA6C7" FontSize="11" />
                    <TextBlock Text="v1.3 • WinUI 3" Foreground="{ThemeResource SidebarSectionBrush}" FontSize="10" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Column="1" Padding="32,22,32,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{ThemeResource AccentBrush}">
                        <TextBlock Text="➤" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="AnyDesk" Foreground="{ThemeResource AccentBrush}" FontSize="18" FontWeight="Bold" Margin="10,0,0,0" />
                    <TextBlock Text=" Rehber" Foreground="{ThemeResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="  •  Bilgisayar yönetimi" Foreground="{ThemeResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <Button x:Name="ThemeButton" Style="{StaticResource IconButtonStyle}" Click="ThemeButton_Click" HorizontalAlignment="Right" ToolTipService.ToolTip="Açık / koyu tema">
                    <Border Width="40" Height="40" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <TextBlock x:Name="ThemeIcon" Text="☼" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,18,0,20">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="48" Height="48" CornerRadius="14" Background="{ThemeResource AccentSoftBrush}">
                        <TextBlock x:Name="PageIcon" Text="▣" Foreground="{ThemeResource AccentBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="Bilgisayarlar" Foreground="{ThemeResource TextPrimaryBrush}" FontSize="25" FontWeight="Bold" />
                        <TextBlock x:Name="PageSubtitle" Text="Kayıtlı uzak bilgisayarlarını hızlıca yönet." Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="10">
                    <TextBox x:Name="SearchBox"
                             Width="250"
                             Height="42"
                             PlaceholderText="Bilgisayar ara..."
                             TextAlignment="Left"
                             HorizontalContentAlignment="Left"
                             VerticalContentAlignment="Center"
                             Padding="14,10"
                             TextChanged="SearchBox_TextChanged" />
                    <Button Content="＋  Yeni bilgisayar" Style="{StaticResource PrimaryButtonStyle}" Click="AddButton_Click" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <controls:ItemsRepeater x:Name="ContactsRepeater">
                    <controls:ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="310" MinItemHeight="250" MinRowSpacing="16" MinColumnSpacing="16" />
                    </controls:ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border Height="250" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="52" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="40" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Border Width="46" Height="46" CornerRadius="14" Background="{ThemeResource AccentSoftBrush}">
                                                <TextBlock Text="{Binding Initials}" Foreground="{ThemeResource AccentBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="{ThemeResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Group}" Foreground="{ThemeResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Tag="{Binding}" Click="Favorite_Click" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right" Width="36" Height="36" ToolTipService.ToolTip="Favoriye ekle / çıkar">
                                            <Grid Width="28" Height="28">
                                                <TextBlock Text="★" FontSize="20" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Favorite, Converter={StaticResource FavoriteVisibilityConverter}}" />
                                                <TextBlock Text="☆" FontSize="20" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Favorite, Converter={StaticResource FavoriteVisibilityConverter}, ConverterParameter=Invert}" />
                                            </Grid>
                                        </Button>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,2,0,6">
                                        <StackPanel VerticalAlignment="Center" Spacing="7">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center">
                                                    <Ellipse.Fill>
                                                        <Binding Path="Status" Converter="{StaticResource StatusBrushConverter}" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusLabelConverter}}" Foreground="{Binding Status, Converter={StaticResource StatusTextBrushConverter}}" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <Grid Height="48" Background="{ThemeResource PageBackgroundBrush}">
                                                <TextBlock Text="{Binding Address}"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center"
                                                           Margin="38,0,38,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button Tag="{Binding}" Click="Copy_Click" Content="⧉" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" ToolTipService.ToolTip="ID'yi kopyala" />
                                            </Grid>

                                            <TextBlock Text="{Binding Note}"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       Height="32"
                                                       MaxHeight="32"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="WordEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="2" VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Tag="{Binding}" Click="Connect_Click" Content="Bağlan  ›" Style="{StaticResource PrimaryButtonStyle}" Height="40" />
                                            <Button Tag="{Binding}" Click="Edit_Click" Content="Düzenle" Style="{StaticResource SubtleButtonStyle}" Height="40" />
                                        </StackPanel>
                                        <Button Tag="{Binding}" Click="Delete_Click" Content="Sil" HorizontalAlignment="Right" Height="40" Padding="14,0" ToolTipService.ToolTip="Bilgisayarı sil" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </controls:ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <!-- Minimal copy notification -->
        <Border x:Name="CopyToast"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,34,26"
                Padding="12,7"
                Background="{ThemeResource ToastBrush}"
                CornerRadius="8"
                Opacity="0"
                IsHitTestVisible="False">
            <TextBlock x:Name="CopyToastText" Text="ID kopyalandı" Foreground="White" FontSize="11" />
        </Border>
    </Grid>
</Window>
